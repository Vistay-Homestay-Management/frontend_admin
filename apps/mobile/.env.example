# Public mobile configuration only. A native/public Keycloak client must not have a secret.
EXPO_PUBLIC_GRAPHQL_URL=https://graphql.vistay.example/graphql
EXPO_PUBLIC_OIDC_ISSUER=https://identity.vistay.example/realms/vistay-backoffice
EXPO_PUBLIC_OIDC_CLIENT_ID=vistay-backoffice-mobile
# Optional for development builds; defaults to vistay-admin://oauth/callback.
EXPO_PUBLIC_OIDC_REDIRECT_URI=vistay-admin://oauth/callback
