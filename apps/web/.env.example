# Public browser configuration only. Never put a Keycloak client secret here.
VITE_GRAPHQL_URL=http://graphql.localhost/graphql
VITE_OIDC_ISSUER=http://identity.localhost/realms/vistay-backoffice
VITE_OIDC_CLIENT_ID=vistay-backoffice-web
# Optional; defaults to {window.origin}/auth/callback.
VITE_OIDC_REDIRECT_URI=http://admin.localhost/auth/callback
